\set ON_ERROR_STOP on
-- StockOS Render free STAGING ONLY. Execute interactively in psql while
-- connected as an administrator to stockos_java_staging_temp. Passwords are
-- entered via \password (never stored in Git or history).
SELECT (current_database() = 'stockos_java_staging_temp')::text AS expected_database \gset
\if :expected_database
\echo Confirmed disposable StockOS staging database.
\else
\echo ABORT: refusing role provisioning outside stockos_java_staging_temp.
\quit 3
\endif

SELECT (SELECT rolcreaterole OR rolsuper FROM pg_roles WHERE rolname=current_user)::text AS may_create_roles \gset
\if :may_create_roles
\echo Administrator role creation privilege verified.
\else
\echo ABORT: current database user cannot create login roles.
\quit 4
\endif

SELECT (NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN ('stockos_app','stockos_migrator')))::text AS no_role_collision \gset
\if :no_role_collision
\echo Neither role exists; provision new, isolated test identities.
\else
\echo ABORT: role already exists. Inspect existing grants before retrying.
\quit 5
\endif

BEGIN;
CREATE ROLE stockos_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
CREATE ROLE stockos_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
GRANT CONNECT ON DATABASE stockos_java_staging_temp TO stockos_migrator, stockos_app;
GRANT USAGE, CREATE ON SCHEMA public TO stockos_migrator;
GRANT USAGE ON SCHEMA public TO stockos_app;
REVOKE CREATE ON SCHEMA public FROM stockos_app;
COMMIT;

\echo Set a unique strong password for migrator (interactive hidden input):
\password stockos_migrator
\echo Set a DIFFERENT strong password for runtime (interactive hidden input):
\password stockos_app
\echo Provisioned. Before migrations inspect role privileges and DATABASE/schema ownership.
SELECT rolname, rolsuper, rolcreatedb, rolcreaterole, rolbypassrls
FROM pg_roles WHERE rolname IN ('stockos_app','stockos_migrator');
SELECT rolname, has_database_privilege(rolname,current_database(),'CREATE') AS can_create_database_objects,
       has_schema_privilege(rolname,'public','CREATE') AS can_create_schema_objects
FROM pg_roles WHERE rolname IN ('stockos_app','stockos_migrator');
