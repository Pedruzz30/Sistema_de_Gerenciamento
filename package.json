{
  "name": "stockos-frontend-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Vite development server for existing StockOS HTML/CSS/JS pages",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "dev:check": "node --check vite.config.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "check:preview": "node --check src/main/resources/static/js/preview-mock.js && node --check scripts/build-preview.mjs"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
