# Local Docker development only. Copy to .env and change the password.
# This user is a local PostgreSQL superuser so Flyway tests can create/drop
# disposable databases; NEVER reuse these credentials on Supabase Cloud.
STOCKOS_DB_PASSWORD=change_me_local_only
STOCKOS_DB_PORT=5433

# Auth switch (opt-in for a dedicated StockOS staging project only).
# DO NOT enable until user UUIDs are manually linked to users.ru in stockos DB.
# STOCKOS_AUTH_MODE=supabase
# STOCKOS_SUPABASE_URL=https://your-stockos-project.supabase.co
# STOCKOS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# STOCKOS_CORS_ORIGIN=http://127.0.0.1:5173
